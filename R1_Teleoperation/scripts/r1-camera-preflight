#!/usr/bin/env bash
set -euo pipefail

# Read-only inventory for the R1 camera/network path.  This script never opens
# a V4L2 device and never creates a DDS application writer.  ddsls creates a
# bounded discovery participant, but publishes no camera, API, or motor data.

INTERFACE="${R1_CAMERA_INTERFACE:-enxb4b024be59fe}"
CONTROL_IP="${R1_CONTROL_IP:-192.168.123.161}"
PC2_IP="${R1_PC2_IP:-192.168.123.164}"
DDS_SECONDS="${R1_DDS_DISCOVERY_SECONDS:-4}"
DDS_ENABLED=true
RESULT=0

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/r1-network-autodetect
source "${PROJECT_DIR}/scripts/r1-network-autodetect"

usage() {
  cat <<'EOF'
Usage: r1-camera-preflight [options]

Read-only inventory of the Unitree R1 camera/network path.

Options:
  --interface NAME     Robot-facing network interface
  --control-ip IPV4    R1 native DDS/control-computer address
  --pc2-ip IPV4        R1 development computer (PC2) address
  --dds-seconds N      Bounded DDS discovery time, 1..30 seconds
  --skip-dds           Skip native DDS endpoint discovery
  -h, --help           Show this help

Environment equivalents: R1_CAMERA_INTERFACE, R1_CONTROL_IP, R1_PC2_IP,
R1_DDS_DISCOVERY_SECONDS.

The script sends only bounded ICMP/TCP reachability probes and, unless
--skip-dds is used, DDS discovery announcements. It does not publish DDS
application data, call videohub, run TeleImager, reload drivers, open cameras,
or access actuator topics.
EOF
}

mark_ok() {
  printf '[OK] %s\n' "$*"
}

mark_warn() {
  printf '[WARN] %s\n' "$*"
  if [[ "${RESULT}" -eq 0 ]]; then
    RESULT=2
  fi
}

mark_fail() {
  printf '[FAIL] %s\n' "$*" >&2
  RESULT=1
}

section() {
  printf '\n== %s ==\n' "$*"
}

valid_ipv4() {
  local address="$1"
  local octets=()
  local octet
  IFS='.' read -r -a octets <<< "${address}"
  [[ "${#octets[@]}" -eq 4 ]] || return 1
  for octet in "${octets[@]}"; do
    [[ "${octet}" =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#${octet} <= 255)) || return 1
  done
}

tcp_probe() {
  local host="$1"
  local port="$2"
  nc -z -w 1 "${host}" "${port}" </dev/null >/dev/null 2>&1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --interface)
      [[ $# -ge 2 ]] || { usage >&2; exit 1; }
      INTERFACE="$2"
      shift 2
      ;;
    --control-ip)
      [[ $# -ge 2 ]] || { usage >&2; exit 1; }
      CONTROL_IP="$2"
      shift 2
      ;;
    --pc2-ip)
      [[ $# -ge 2 ]] || { usage >&2; exit 1; }
      PC2_IP="$2"
      shift 2
      ;;
    --dds-seconds)
      [[ $# -ge 2 ]] || { usage >&2; exit 1; }
      DDS_SECONDS="$2"
      shift 2
      ;;
    --skip-dds)
      DDS_ENABLED=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! "${INTERFACE}" =~ ^[[:alnum:]_.-]{1,15}$ ]]; then
  printf 'Invalid interface name: %s\n' "${INTERFACE}" >&2
  exit 1
fi
if ! valid_ipv4 "${CONTROL_IP}"; then
  printf 'Invalid control IPv4 address: %s\n' "${CONTROL_IP}" >&2
  exit 1
fi
if ! valid_ipv4 "${PC2_IP}"; then
  printf 'Invalid PC2 IPv4 address: %s\n' "${PC2_IP}" >&2
  exit 1
fi
if [[ ! "${DDS_SECONDS}" =~ ^([1-9]|[12][0-9]|30)$ ]]; then
  printf 'DDS discovery time must be an integer from 1 to 30.\n' >&2
  exit 1
fi

resolved_control_ip="$(r1_resolve_control_ip "${INTERFACE}" "${CONTROL_IP}" "${PC2_IP}" || true)"
if [[ -n "${resolved_control_ip}" && "${resolved_control_ip}" != "${CONTROL_IP}" ]]; then
  printf '[INFO] native DDS %s is not reachable; using reachable fallback %s\n' \
    "${CONTROL_IP}" "${resolved_control_ip}"
  CONTROL_IP="${resolved_control_ip}"
fi

printf 'R1 camera/network preflight (read-only)\n'
printf 'Interface: %s | native DDS: %s | PC2: %s\n' \
  "${INTERFACE}" "${CONTROL_IP}" "${PC2_IP}"

section 'Robot-facing interface'
if ip -o link show dev "${INTERFACE}" >/dev/null 2>&1; then
  link_line="$(ip -br link show dev "${INTERFACE}")"
  printf '%s\n' "${link_line}"
  if [[ "${link_line}" == *' UP '* ]]; then
    mark_ok "${INTERFACE} is up"
  else
    mark_warn "${INTERFACE} exists but is not up"
  fi
  ipv4_lines="$(ip -br -4 address show dev "${INTERFACE}")"
  if [[ -n "${ipv4_lines}" ]]; then
    printf '%s\n' "${ipv4_lines}"
    mark_ok 'robot-facing IPv4 address is configured'
  else
    mark_fail "${INTERFACE} has no IPv4 address"
  fi
else
  mark_fail "network interface ${INTERFACE} does not exist"
fi

section 'Bounded reachability probes'
if command -v ping >/dev/null 2>&1; then
  for endpoint in "native DDS:${CONTROL_IP}" "PC2:${PC2_IP}"; do
    label="${endpoint%%:*}"
    address="${endpoint#*:}"
    if ping -I "${INTERFACE}" -c 1 -W 1 "${address}" \
      >/dev/null 2>&1; then
      mark_ok "${label} ${address} replies to ICMP"
    else
      mark_warn "${label} ${address} did not reply to one ICMP probe"
    fi
  done
else
  mark_warn 'ping is unavailable; ICMP checks skipped'
fi

if command -v nc >/dev/null 2>&1; then
  for probe in '22:SSH' '4000:NoMachine' '55555:TeleImager-ZMQ' \
    '60001:TeleImager-WebRTC'; do
    port="${probe%%:*}"
    label="${probe#*:}"
    if tcp_probe "${PC2_IP}" "${port}"; then
      mark_ok "PC2 ${label} TCP/${port} is accepting connections"
    elif [[ "${port}" == 55555 || "${port}" == 60001 ]]; then
      mark_warn "PC2 ${label} TCP/${port} is closed or filtered"
    else
      printf '[INFO] PC2 %s TCP/%s is closed or filtered\n' \
        "${label}" "${port}"
    fi
  done
else
  mark_warn 'nc is unavailable; TCP connect checks skipped'
fi

section 'Local V4L2 inventory (metadata only)'
shopt -s nullglob
video_devices=(/dev/video*)
if [[ "${#video_devices[@]}" -eq 0 ]]; then
  printf '[INFO] No local /dev/video* nodes found.\n'
else
  for device in "${video_devices[@]}"; do
    product='unknown'
    serial='unknown'
    capabilities='unknown'
    readable='no'
    if [[ -r "${device}" ]]; then
      readable='yes'
    fi
    if command -v udevadm >/dev/null 2>&1; then
      properties="$(udevadm info --query=property --name="${device}" \
        2>/dev/null || true)"
      product="$(awk -F= '$1 == "ID_V4L_PRODUCT" {print substr($0, index($0, "=") + 1)}' \
        <<< "${properties}")"
      serial="$(awk -F= '$1 == "ID_SERIAL" {print substr($0, index($0, "=") + 1)}' \
        <<< "${properties}")"
      capabilities="$(awk -F= '$1 == "ID_V4L_CAPABILITIES" {print substr($0, index($0, "=") + 1)}' \
        <<< "${properties}")"
    fi
    printf '%s product=%s serial=%s capabilities=%s readable=%s\n' \
      "${device}" "${product:-unknown}" "${serial:-unknown}" \
      "${capabilities:-unknown}" "${readable}"
  done
  printf '[INFO] These nodes belong to this computer; they are not proof of an R1 camera.\n'
fi
if [[ -d /dev/v4l/by-id ]]; then
  while IFS= read -r stable_path; do
    printf 'stable-id %s -> %s\n' \
      "${stable_path}" "$(readlink -f "${stable_path}")"
  done < <(find /dev/v4l/by-id -maxdepth 1 -type l -print | sort)
fi

section 'Native DDS camera endpoint discovery'
if [[ "${DDS_ENABLED}" != true ]]; then
  printf '[INFO] DDS discovery skipped by request.\n'
else
  DDSLS_BIN="$(command -v ddsls || true)"
  if [[ -z "${DDSLS_BIN}" || ! -x "${DDSLS_BIN}" ]]; then
    mark_warn 'ddsls is unavailable; native camera endpoints were not checked'
  elif ! command -v jq >/dev/null 2>&1; then
    mark_warn 'jq is unavailable; ddsls JSON cannot be summarized safely'
  elif ! ip -o link show dev "${INTERFACE}" >/dev/null 2>&1; then
    mark_warn 'DDS discovery skipped because the selected interface is absent'
  else
    DDS_URI='<CycloneDDS><Domain><General><Interfaces>'
    DDS_URI+="<NetworkInterface name=\"${INTERFACE}\"/>"
    DDS_URI+='</Interfaces></General></Domain></CycloneDDS>'
    set +e
    dds_json="$(env CYCLONEDDS_URI="${DDS_URI}" \
      timeout "$((DDS_SECONDS + 4))" "${DDSLS_BIN}" \
      --all --runtime "${DDS_SECONDS}" --json 2>/dev/null)"
    dds_status=$?
    set -e
    if [[ "${dds_status}" -ne 0 || -z "${dds_json}" ]] \
      || ! jq -e . >/dev/null 2>&1 <<< "${dds_json}"; then
      mark_warn "DDS discovery did not return valid JSON (status ${dds_status})"
    else
      publications="$(jq -r '
        .[] | select(.type == "PUBLICATION") | .value[]? |
        [.topic_name, .type_name] | @tsv
      ' <<< "${dds_json}" | sort -u)"
      subscriptions="$(jq -r '
        .[] | select(.type == "SUBSCRIPTION") | .value[]? |
        [.topic_name, .type_name] | @tsv
      ' <<< "${dds_json}" | sort -u)"
      camera_endpoints="$(printf '%s\n%s\n' \
        "${publications}" "${subscriptions}" \
        | awk -F '\t' 'tolower($1) ~ /(video|webrtc|camera|image)/' \
        | sort -u)"

      if [[ -n "${camera_endpoints}" ]]; then
        printf '%s\n' "${camera_endpoints}"
        mark_ok 'camera/video-related DDS endpoint names were discovered'
      else
        mark_warn 'no camera/video-related DDS endpoint names were discovered'
      fi

      if awk -F '\t' '$1 == "rt/frontvideostream" {found=1} END {exit !found}' \
        <<< "${publications}"; then
        mark_ok 'rt/frontvideostream has a DDS writer'
      else
        mark_warn 'rt/frontvideostream has no discovered DDS writer'
      fi

      request_reader=false
      response_writer=false
      if awk -F '\t' '$1 == "rt/api/videohub/request" {found=1} END {exit !found}' \
        <<< "${subscriptions}"; then
        request_reader=true
      fi
      if awk -F '\t' '$1 == "rt/api/videohub/response" {found=1} END {exit !found}' \
        <<< "${publications}"; then
        response_writer=true
      fi
      if [[ "${request_reader}" == true && "${response_writer}" == true ]]; then
        mark_ok 'videohub request reader and response writer are both present'
      else
        server_state="request-reader=${request_reader}, "
        server_state+="response-writer=${response_writer}"
        mark_warn "videohub server endpoints incomplete (${server_state})"
        printf '%s\n' \
          '[ACTION] This firmware does not expose a Service Status menu in Explore.' \
          '[ACTION] Explore receives camera video through the R1 Wi-Fi AP; Ethernet-only control cannot provide that stream.' \
          '[ACTION] For wired-only operation use a second Wi-Fi adapter (or provide the R1 AP password) and bridge the camera path.' \
          '[SAFETY] Do not enable motion, debug, sport, or low-level control services for this video-only check.'
      fi
    fi
  fi
fi

section 'Result'
case "${RESULT}" in
  0) printf 'OK: no preflight warnings detected.\n' ;;
  2) printf 'WARN: inventory completed; review warnings before starting video.\n' ;;
  *) printf 'FAIL: a required local configuration check failed.\n' ;;
esac
printf 'No camera device was opened and no DDS application command was sent.\n'
exit "${RESULT}"
