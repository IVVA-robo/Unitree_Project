#!/usr/bin/env python3
"""Inspect wake-name acceptance, response style, and fast templates."""

import argparse
import json
from pathlib import Path
import sys


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT))

from voice_assistant.response_style import (  # noqa: E402
    ResponseLengthPolicy,
    quick_template_answer,
)
from voice_assistant.wake_name_gate import WakeNameGate  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("text", nargs="*", help="one mock ASR phrase")
    args = parser.parse_args()
    gate = WakeNameGate.from_env()
    policy = ResponseLengthPolicy.from_env()
    lines = [" ".join(args.text)] if args.text else sys.stdin
    for line in lines:
        raw_text = line.rstrip("\n")
        gate_result = gate.process(raw_text)
        item = {"raw_text": raw_text, **gate_result.as_dict()}
        if gate_result.accepted and gate_result.stripped_text:
            decision = policy.decide(gate_result.stripped_text)
            template = quick_template_answer(gate_result.stripped_text)
            item.update(
                {
                    "response_length": decision.style,
                    "length_reason": decision.reason,
                    "source": "template" if template else "llm",
                    "response": template or (
                        f"<LLM response: {decision.style}>"
                    ),
                }
            )
        print(json.dumps(item, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
