#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${PROJECT_DIR}"
if [[ ${1-} == control && ${R1_VR_TRANSPORT:-lan} == usb && ${R1_USB_MANAGED:-0} != 1 ]]; then
  exec python3 -m usb_link.control "$@"
fi
exec python3 -m exhibition.orchestrator "$@"
