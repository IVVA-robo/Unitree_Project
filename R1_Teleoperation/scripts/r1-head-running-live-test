#!/usr/bin/env bash
set -euo pipefail

# Start the fail-closed head-only writer and allow prepare to enter the
# official FSM 811 controller. No joystick, SetVelocity, or arm path exists.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ $# -eq 0 ]] || { echo 'Usage: r1-head-running-live-test' >&2; exit 2; }
exec "${SCRIPT_DIR}/r1-live-auto-run" "${SCRIPT_DIR}/r1-live-session" head-running
