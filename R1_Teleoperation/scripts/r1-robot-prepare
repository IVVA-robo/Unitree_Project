#!/usr/bin/env bash
set -euo pipefail

# Prepare is intentionally a client of an already-running live session. It
# cannot create a writer itself. The operator must hold Deadman while this
# command runs; any failed step reasserts both writer and supervisor kill.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
WORKSPACE_SETUP="${PROJECT_DIR}/ros2_ws/install/setup.bash"
[[ -f "${WORKSPACE_SETUP}" ]] || WORKSPACE_SETUP="${PROJECT_DIR}/install/setup.bash"

die() {
  echo "[BLOCKED] $*" >&2
  echo 'Prepare/StandUp was not requested.' >&2
  exit 2
}

[[ $# -eq 0 ]] || die 'usage: r1-robot-prepare'
[[ -f /opt/ros/humble/setup.bash ]] || die 'ROS 2 Humble is unavailable'
[[ -f "${WORKSPACE_SETUP}" ]] || die "workspace is not built: ${WORKSPACE_SETUP}"

require_exact() {
  local name=$1 expected=$2 value=${!1-}
  [[ "${value}" == "${expected}" ]] || die "${name}=${expected} is required"
}
require_exact ROBOT_DRY_RUN 0
require_exact ROBOT_ENABLE_ACTUATION 1
require_exact ROBOT_CONFIRM_OFF_CHARGER 1
require_exact ROBOT_CONFIRM_CLEAR_AREA 1
require_exact ROBOT_CONFIRM_ESTOP_READY 1
require_exact ROBOT_CONFIRM_COMMISSIONING 1
TOKEN=${ROBOT_COMMISSIONING_TOKEN-}
[[ ${#TOKEN} -ge 16 ]] \
  || die 'ROBOT_COMMISSIONING_TOKEN must contain at least 16 characters'
if [[ ${ROBOT_CONFIRM_STATIC_PREPARE-0} != 1 ]]; then
  [[ -n ${ROBOT_VR_SOURCE_IP-} ]] || die 'ROBOT_VR_SOURCE_IP is required'
fi

DOMAIN_ID=${R1_LIVE_ROS_DOMAIN_ID:-88}
[[ "${DOMAIN_ID}" =~ ^[0-9]+$ ]] && ((10#${DOMAIN_ID} <= 232)) \
  || die 'R1_LIVE_ROS_DOMAIN_ID must be 0..232'
INTERFACE=${R1_LIVE_NETWORK_INTERFACE:-enxb4b024be59fe}
PRIMARY_CONTROL_IP=${R1_LIVE_CONTROL_IP:-${R1_CONTROL_IP:-192.168.123.161}}
PC2_IP=${R1_PC2_IP:-${R1_ROBOT_IP:-192.168.123.164}}

# shellcheck source=scripts/r1-network-autodetect
source "${SCRIPT_DIR}/r1-network-autodetect"
CONTROL_IP="$(r1_resolve_control_ip "${INTERFACE}" "${PRIMARY_CONTROL_IP}" "${PC2_IP}" || true)"

set +u
source /opt/ros/humble/setup.bash
source "${WORKSPACE_SETUP}"
# Match the already-running physical graph without loading Unitree SDK in this
# service client.
# shellcheck source=r1-physical-ros-env
source "${SCRIPT_DIR}/r1-physical-ros-env"
set -u
export ROS_DOMAIN_ID="$((10#${DOMAIN_ID}))"
export ROS_LOCALHOST_ONLY=1

# Static readiness has just used one DDS participant to verify the complete
# typed graph, exact featureless writer policy and this commissioning token.
# Consume that proof before trusting it; it is HMAC-bound to this boot,
# manager session and ROS domain and cannot be replayed. Control and direct
# commissioning paths retain the full discovery below.
STATIC_READINESS_ATTESTED=false
if [[ ${R1_EXHIBITION_STATIC_READINESS-0} == 1 ]]; then
  [[ ${R1_EXHIBITION_FAST_PREPARE-0} == 1 \
      && ${ROBOT_CONFIRM_STATIC_PREPARE-0} == 1 ]] \
    || die 'static readiness reuse requires the fast static prepare contract'
  ATTESTATION_PATH=${R1_EXHIBITION_READINESS_ATTESTATION-}
  EXHIBITION_SESSION_ID=${R1_EXHIBITION_SESSION_ID-}
  [[ ${ATTESTATION_PATH} == /* ]] \
    || die 'static fast prepare requires an absolute readiness attestation path'
  [[ ${EXHIBITION_SESSION_ID} =~ ^[0-9a-f]{32}$ ]] \
    || die 'static fast prepare requires the current exhibition session id'
  python3 "${PROJECT_DIR}/exhibition/readiness_attestation.py" consume \
    --path "${ATTESTATION_PATH}" \
    --session-id "${EXHIBITION_SESSION_ID}" \
    --mode static \
    --domain-id "$((10#${DOMAIN_ID}))" \
    || die 'static graph readiness attestation was not accepted'
  STATIC_READINESS_ATTESTED=true
fi

# `ros2 service type` is daemon-backed on Humble and can fail with a stale
# XML-RPC daemon (`rclpy.ok()` fault) even while the live services are healthy.
# Discover the complete typed graph directly instead.  Require all four
# services in the same snapshot so an incomplete discovery result cannot
# release either software kill.
service_exists() {
  local name=$1 type=$2
  grep -Fqx -- "${name} [${type}]" <<<"${service_graph}"
}
required_service_graph_ready() {
  service_exists /r1/live_writer/prepare std_srvs/srv/Trigger \
    && service_exists /r1/live_writer/reset_kill std_srvs/srv/Trigger \
    && service_exists /r1/live_writer/kill std_srvs/srv/Trigger \
    && service_exists /r1/safety/set_kill std_srvs/srv/SetBool
}

service_graph=''
if [[ ${STATIC_READINESS_ATTESTED} == true ]]; then
  service_graph=$'/r1/live_writer/prepare [std_srvs/srv/Trigger]\n/r1/live_writer/reset_kill [std_srvs/srv/Trigger]\n/r1/live_writer/kill [std_srvs/srv/Trigger]\n/r1/safety/set_kill [std_srvs/srv/SetBool]'
else
  for attempt in 1 2 3 4; do
    if ! service_graph="$(timeout 6s ros2 service list --no-daemon \
        --spin-time 1.0 --show-types 2>/dev/null)"; then
      service_graph=''
    fi
    required_service_graph_ready && break
    sleep 0.25
  done
fi
for service in \
  /r1/live_writer/prepare \
  /r1/live_writer/reset_kill \
  /r1/live_writer/kill; do
  service_exists "${service}" std_srvs/srv/Trigger \
    || die "required live-session service is absent: ${service}"
done
service_exists /r1/safety/set_kill std_srvs/srv/SetBool \
  || die 'safety supervisor service is absent: /r1/safety/set_kill'

# Capture one coherent parameter snapshot.  The previous implementation
# started a new DDS participant for every parameter; on a healthy physical
# graph that added tens of seconds and could mix values from different
# discovery snapshots.  This dump is read-only and is never printed because it
# contains the commissioning token.
parameter_dump=''
if [[ ${STATIC_READINESS_ATTESTED} == true ]]; then
  # These non-secret values are the exact policy covered by the consumed
  # readiness HMAC.  The commissioning token itself is deliberately absent.
  parameter_dump=$'/r1_live_writer:\n  ros__parameters:\n    transport: sdk\n    send_commands: true\n    enable_prepare: true\n    profile: slow-safe\n    static_prepare_mode: true\n    exhibition_session_mode: false\n    enable_head: false\n    enable_arms: false\n    enable_locomotion: false\n    prepare_enter_locomotion: false\n    arm_topic: /unused/static\n    head_recenter_enabled: false'
else
  for attempt in 1 2 3 4; do
    parameter_dump="$(timeout 7s ros2 param dump /r1_live_writer \
      --no-daemon --spin-time 1.5 2>/dev/null || true)"
    if grep -Fq '/r1_live_writer:' <<<"${parameter_dump}" \
        && grep -Eq '^[[:space:]]+commissioning_token:' \
          <<<"${parameter_dump}"; then
      break
    fi
    parameter_dump=''
    sleep 0.25
  done
fi
[[ -n ${parameter_dump} ]] \
  || die 'live writer parameter snapshot is unavailable'

dump_scalar() {
  local name=$1
  awk -v key="${name}:" '
    $1 == key {
      $1 = ""
      sub(/^[[:space:]]+/, "")
      if (($0 ~ /^".*"$/) || ($0 ~ /^\047.*\047$/)) {
        $0 = substr($0, 2, length($0) - 2)
      }
      print
      found = 1
      exit
    }
    END { if (!found) exit 1 }
  ' <<<"${parameter_dump}"
}

get_live_writer_param() {
  local name=$1 expected_kind=$2 value
  value="$(dump_scalar "${name}" 2>/dev/null || true)"
  case ${expected_kind} in
    string)
      [[ -n ${value} ]] || return 1
      printf 'String value is: %s\n' "${value}"
      ;;
    boolean)
      [[ ${value} == true || ${value} == false ]] || return 1
      printf 'Boolean value is: %s\n' "${value}"
      ;;
    *) return 2 ;;
  esac
}

require_param() {
  local name=$1 expected_kind=$2 expected=$3 value
  if ! value="$(get_live_writer_param "${name}" "${expected_kind}")"; then
    die "live writer parameter ${name} is unavailable or not ${expected_kind}"
  fi
  grep -Fqi -- "${expected}" <<<"${value}" \
    || die "live writer parameter ${name} is not ${expected}: ${value:-unavailable}"
}
require_param transport string 'string value is: sdk'
require_param send_commands boolean 'boolean value is: true'
require_param enable_prepare boolean 'boolean value is: true'
require_param profile string 'string value is: slow-safe'

if ! static_prepare_mode="$(get_live_writer_param static_prepare_mode boolean)"; then
  die 'live writer parameter static_prepare_mode is unavailable or not boolean'
fi
if ! exhibition_session_mode="$(
    get_live_writer_param exhibition_session_mode boolean)"; then
  die 'live writer parameter exhibition_session_mode is unavailable or not boolean'
fi

FAST_PREPARE=false
case ${R1_EXHIBITION_FAST_PREPARE-0} in
  0) ;;
  1)
    # The fast path is limited to the panel's already-discovered exhibition
    # graph and the exact writer created with this commissioning token.  It
    # only removes duplicate process/discovery work; all current feedback,
    # topic, traffic, KILL and prepare confirmations below remain mandatory.
    if grep -Fqi 'boolean value is: true' <<<"${static_prepare_mode}"; then
      require_exact ROBOT_CONFIRM_STATIC_PREPARE 1
      grep -Fqi 'boolean value is: false' <<<"${exhibition_session_mode}" \
        || die 'fast static prepare must not be an exhibition control writer'
      for feature in enable_head enable_arms enable_locomotion prepare_enter_locomotion; do
        require_param "${feature}" boolean 'boolean value is: false'
      done
    else
      require_exact ROBOT_EXHIBITION_SESSION 1
      grep -Fqi 'boolean value is: true' <<<"${exhibition_session_mode}" \
        || die 'fast prepare requires exhibition_session_mode=true'
    fi
    if [[ ${STATIC_READINESS_ATTESTED} != true ]]; then
      writer_token="$(dump_scalar commissioning_token 2>/dev/null || true)"
      [[ -n ${writer_token} && ${writer_token} == "${TOKEN}" ]] \
        || die 'fast prepare token does not match the running live writer'
      unset writer_token
    fi
    FAST_PREPARE=true
    ;;
  *) die 'R1_EXHIBITION_FAST_PREPARE must be 0 or 1' ;;
esac

if ! head_enabled="$(get_live_writer_param enable_head boolean)"; then
  die 'live writer parameter enable_head is unavailable or not boolean'
fi
if ! locomotion_enabled="$(get_live_writer_param enable_locomotion boolean)"; then
  die 'live writer parameter enable_locomotion is unavailable or not boolean'
fi
if ! prepare_enter_locomotion="$(
    get_live_writer_param prepare_enter_locomotion boolean)"; then
  die 'live writer parameter prepare_enter_locomotion is unavailable or not boolean'
fi
if ! arms_enabled="$(get_live_writer_param enable_arms boolean)"; then
  die 'live writer parameter enable_arms is unavailable or not boolean'
fi
if ! arm_topic_param="$(get_live_writer_param arm_topic string)"; then
  die 'live writer parameter arm_topic is unavailable or not string'
fi
if ! head_recenter_enabled="$(get_live_writer_param head_recenter_enabled boolean)"; then
  die 'live writer parameter head_recenter_enabled is unavailable or not boolean'
fi
if ! grep -Fqi 'boolean value is: true' <<<"${head_enabled}" \
  && ! grep -Fqi 'boolean value is: true' <<<"${arms_enabled}" \
  && ! grep -Fqi 'boolean value is: true' <<<"${locomotion_enabled}"; then
  grep -Fqi 'boolean value is: true' <<<"${static_prepare_mode}" \
    || die 'featureless writer is allowed only in static_prepare_mode'
  require_exact ROBOT_CONFIRM_STATIC_PREPARE 1
  grep -Fqi 'boolean value is: false' <<<"${prepare_enter_locomotion}" \
    || die 'static prepare must not request Start/FSM 811'
else
  grep -Fqi 'boolean value is: false' <<<"${static_prepare_mode}" \
    || die 'static prepare writer must not enable head, arms, or locomotion'
fi
head_auto_center_required=false
if grep -Fqi 'boolean value is: true' <<<"${head_enabled}"; then
  require_param head_absolute_envelope_confirmed boolean \
    'boolean value is: true'
  if grep -Fqi 'boolean value is: true' <<<"${head_recenter_enabled}"; then
    require_exact ROBOT_CONFIRM_HEAD_OWNERSHIP_PROBE 1
    require_param head_recenter_confirmed boolean 'boolean value is: false'
    require_param head_ownership_probe_only boolean 'boolean value is: true'
    require_param head_ownership_probe_confirmed boolean 'boolean value is: true'
    head_probe_mode=true
  else
    head_probe_mode=false
  fi
fi

if [[ ${FAST_PREPARE} == true ]]; then
  echo 'Using the current token-bound exhibition graph; duplicate SDK preflight is already complete.'
else
  echo 'Running strict feedback preflight against the live session reader...'
  R1_SDK_NETWORK_INTERFACE="${INTERFACE}" \
  R1_CONTROL_IP="${CONTROL_IP}" \
  R1_SDK_ROS_DOMAIN_ID="${ROS_DOMAIN_ID}" \
    "${SCRIPT_DIR}/r1-sdk-preflight" --no-reader
fi

if [[ ${STATIC_READINESS_ATTESTED} == true ]]; then
  echo 'Using the fresh static graph observation; VR/debug observation is not applicable.'
elif grep -Fqi 'boolean value is: true' <<<"${static_prepare_mode}"; then
  echo 'Observing the featureless static graph without releasing kill...'
  require_vr_args=()
else
  echo 'Observing the live VR/control graph without releasing kill...'
  require_vr_args=(--require-vr)
fi
if [[ ${STATIC_READINESS_ATTESTED} != true ]]; then
  set +e
  vr_preflight_output="$(ros2 run r1_teleop_safety r1_teleop_preflight \
    --interface "${INTERFACE}" \
    --robot-ip "${CONTROL_IP}" \
    --observe-seconds 2.0 \
    "${require_vr_args[@]}" \
    --locomotion-mode slow-safe 2>&1)"
  vr_preflight_status=$?
  set -e
  printf '%s\n' "${vr_preflight_output}"
  if ((vr_preflight_status != 0 && vr_preflight_status != 2)) \
    || ! grep -Fq 'No Unitree SDK writer' <<<"${vr_preflight_output}"; then
    die 'VR/control graph preflight failed'
  fi
fi

if grep -Fqi 'boolean value is: true' <<<"${head_enabled}"; then
  head_status="$(timeout 4s ros2 topic echo --once \
    /r1_hardware_adapter/debug/head/status std_msgs/msg/String \
    --field data --no-daemon 2>/dev/null || true)"
  grep -Eqi 'calibrated=(true|True)' <<<"${head_status}" \
    || die 'head neutral is not calibrated; call /r1/head/calibrate_neutral first'
  head_command="$(timeout 4s ros2 topic echo --once --full-length \
    /r1_hardware_adapter/debug/head/joint_trajectory \
    trajectory_msgs/msg/JointTrajectory --no-daemon 2>/dev/null || true)"
  [[ -n ${head_command} ]] || die 'fresh bounded head command was not observed'

  # Check the physical head before releasing either software kill. Five fresh
  # named q/dq samples prevent an off-centre or still-moving head from reaching
  # StandUp only to fail later at the ArmSdk seed boundary.
  set +e
  head_auto_center_mode=false
  if grep -Fqi 'boolean value is: true' <<<"${exhibition_session_mode}" \
      && [[ ${head_probe_mode} == false ]]; then
    head_auto_center_mode=true
  fi
  head_seed_check="$(timeout 6s python3 - \
    "${head_probe_mode}" "${head_auto_center_mode}" <<'PY'
import math
import sys
import time

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import JointState


class HeadSeedCheck(Node):
    def __init__(self):
        super().__init__('r1_head_seed_precheck')
        qos = QoSProfile(depth=10, reliability=ReliabilityPolicy.RELIABLE)
        self.samples = []
        self.failure = ''
        self.create_subscription(
            JointState, '/r1/sdk/joint_states', self.on_state, qos
        )

    def on_state(self, message):
        if self.failure or len(self.samples) >= 5:
            return
        if (len(message.name) != len(message.position)
                or len(message.name) != len(message.velocity)
                or len(set(message.name)) != len(message.name)):
            self.failure = 'malformed name/position/velocity arrays'
            return
        position = dict(zip(message.name, message.position))
        velocity = dict(zip(message.name, message.velocity))
        required = ('head_yaw_joint', 'head_pitch_joint')
        if any(name not in position or name not in velocity for name in required):
            self.failure = 'head joints are missing from JointState'
            return
        values = (
            position['head_yaw_joint'], position['head_pitch_joint'],
            velocity['head_yaw_joint'], velocity['head_pitch_joint'],
        )
        if not all(math.isfinite(value) for value in values):
            self.failure = 'head q/dq contains NaN or Inf'
            return
        self.samples.append(values)


rclpy.init()
node = HeadSeedCheck()
deadline = time.monotonic() + 4.0
try:
    while not node.failure and len(node.samples) < 5 \
            and time.monotonic() < deadline:
        rclpy.spin_once(node, timeout_sec=0.1)
finally:
    node.destroy_node()
    rclpy.shutdown()

if node.failure:
    print(f'[BLOCKED] physical head feedback rejected: {node.failure}')
    raise SystemExit(2)
if len(node.samples) < 5:
    print('[BLOCKED] fewer than five fresh physical head samples arrived')
    raise SystemExit(2)

yaw, pitch, yaw_velocity, pitch_velocity = node.samples[-1]
probe_mode = sys.argv[1].lower() == 'true'
auto_center_mode = sys.argv[2].lower() == 'true'
feedback_margin = 0.01
if probe_mode:
    yaw_limit = 2.0071
    pitch_limit = 0.6283
elif auto_center_mode:
    # This margin accepts only LowState feedback at a servo stop. The live
    # writer clamps every first and subsequent command to the official limits.
    yaw_limit = 2.0071 + feedback_margin
    pitch_limit = 0.6283 + feedback_margin
else:
    yaw_limit = 0.35
    pitch_limit = 0.25
if any(abs(sample[0]) > yaw_limit or abs(sample[1]) > pitch_limit
       for sample in node.samples):
    print(
        '[BLOCKED] physical head is outside the accepted seed envelope: '
        f'yaw={yaw:.6f} pitch={pitch:.6f}; '
        f'limits yaw={yaw_limit:.4f} pitch={pitch_limit:.4f} rad. '
        'Normal tracking cannot start from this pose. The separately reviewed '
        'ownership micro-probe may diagnose axis/ownership but will not recenter it.'
    )
    raise SystemExit(3)
if any(abs(sample[2]) > 0.05 or abs(sample[3]) > 0.05
       for sample in node.samples):
    print(
        '[BLOCKED] physical head is not stationary enough to seed: '
        f'yaw_dq={yaw_velocity:.6f} pitch_dq={pitch_velocity:.6f}; '
        'limit=0.05 rad/s.'
    )
    raise SystemExit(3)
if (max(sample[0] for sample in node.samples)
        - min(sample[0] for sample in node.samples) > 0.01
        or max(sample[1] for sample in node.samples)
        - min(sample[1] for sample in node.samples) > 0.01):
    print('[BLOCKED] physical head position changed across the seed samples')
    raise SystemExit(3)

outside_tracking_window = abs(yaw) > 0.35 or abs(pitch) > 0.25
if auto_center_mode and outside_tracking_window:
    print(
        '[AUTO_CENTER] stable physical head will be centered automatically '
        'before arms and locomotion are enabled: '
        f'yaw={yaw:.6f} pitch={pitch:.6f} '
        f'yaw_dq={yaw_velocity:.6f} pitch_dq={pitch_velocity:.6f}'
    )
else:
    print(
        '[OK] physical head seed is stable and accepted for '
        f'{"ownership micro-probe" if probe_mode else "normal tracking"}: '
        f'yaw={yaw:.6f} pitch={pitch:.6f} '
        f'yaw_dq={yaw_velocity:.6f} pitch_dq={pitch_velocity:.6f}'
    )
PY
)"
  head_seed_status=$?
  set -e
  printf '%s\n' "${head_seed_check}"
  ((head_seed_status == 0)) \
    || die 'physical head seed precheck failed before kill release'
  if grep -Fq '[AUTO_CENTER]' <<<"${head_seed_check}"; then
    head_auto_center_required=true
  fi
fi
if grep -Fqi 'boolean value is: true' <<<"${locomotion_enabled}"; then
  locomotion_command="$(timeout 4s ros2 topic echo --once --full-length \
    /r1/locomotion_dry_run/debug/cmd_vel \
    geometry_msgs/msg/TwistStamped --no-daemon 2>/dev/null || true)"
  [[ -n ${locomotion_command} ]] || die 'fresh bounded locomotion command was not observed'
fi
if grep -Fqi 'boolean value is: true' <<<"${arms_enabled}"; then
  arm_topic="${arm_topic_param#*: }"
  arm_command="$(timeout 5s ros2 topic echo --once --full-length \
    "${arm_topic}" trajectory_msgs/msg/JointTrajectory \
    --no-daemon 2>/dev/null || true)"
  [[ -n ${arm_command} ]] || die "fresh arm IK command was not observed on ${arm_topic}; run /vr/calibrate_body and keep both controllers visible"
  grep -Fq 'left_shoulder_pitch_joint' <<<"${arm_command}" \
    || die "arm IK command on ${arm_topic} does not contain the R1 arm joint set"
fi

if ! grep -Fqi 'boolean value is: true' <<<"${static_prepare_mode}"; then
  deadman="$(timeout 4s ros2 topic echo --once --full-length \
    /vr/teleop/active std_msgs/msg/Bool --no-daemon 2>/dev/null || true)"
  grep -Eq 'data:[[:space:]]*true' <<<"${deadman}" \
    || die 'activate the control session: no fresh true sample was received'
fi

# Close the time-of-check/time-of-use window left by the longer graph, head
# seed, and Deadman checks above.  The live writer has not been authorized to
# publish ArmSdk frames yet, so any LowCmd sample, non-idle/missing action
# state, observer error, or signal interruption must block before either
# software kill is released.  Preserve the observer's exact result for the
# log, but intentionally accept only its single unambiguous idle code (0).
echo 'Repeating the read-only ArmSdk traffic gate immediately before kill release...'
arm_sdk_gate_duration=6.0
# The observer requires a complete two-second stable-writer interval.  A
# window of exactly 2.0 s can end one 50 ms poll before that interval reaches
# the threshold (1.950 s was observed on hardware).  Keep the same required
# stability and give the bounded observer one small scheduling margin.
[[ ${FAST_PREPARE} == true ]] && arm_sdk_gate_duration=2.25
set +e
R1_SDK_NETWORK_INTERFACE="${INTERFACE}" \
  "${SCRIPT_DIR}/r1-arm-sdk-traffic-check" \
    --interface "${INTERFACE}" --duration-sec "${arm_sdk_gate_duration}" \
    --fresh-sec 0.5 --action-fresh-sec 3.5 --min-samples 3 \
    --expected-writers 1
arm_sdk_final_gate_status=$?
set -e
((arm_sdk_final_gate_status == 0)) \
  || die "final ArmSdk traffic gate failed closed (exit ${arm_sdk_final_gate_status})"
echo '[OK] final ArmSdk traffic gate is idle; proceeding to the explicit kill-release step.'

call_trigger() {
  local service=$1 response
  response="$(timeout 8s ros2 service call "${service}" std_srvs/srv/Trigger '{}' 2>&1)" || {
    printf '%s\n' "${response}" >&2
    return 1
  }
  printf '%s\n' "${response}"
  grep -Eq 'success[[:space:]]*=[[:space:]]*True|success:[[:space:]]*true' <<<"${response}"
}

wait_for_prepare_confirmation() {
  # Cold SDK startup plus the vendor's stable FSM-4/FSM-811 confirmation can
  # exceed the old 15 s polling window even after the live graph is healthy.
  # Keep this bounded, but align it with the manager's longer prepare timeout
  # so a successful StandUp/Start cannot be mistaken for a failed RUN.
  local timeout_sec=${R1_EXHIBITION_PREPARE_CONFIRM_TIMEOUT_SEC:-60} deadline status
  [[ ${timeout_sec} =~ ^[1-9][0-9]*$ ]] || die 'R1_EXHIBITION_PREPARE_CONFIRM_TIMEOUT_SEC must be a positive integer'
  ((10#${timeout_sec} <= 120)) || die 'R1_EXHIBITION_PREPARE_CONFIRM_TIMEOUT_SEC must be at most 120'
  deadline=$((SECONDS + 10#${timeout_sec}))
  while ((SECONDS < deadline)); do
    status="$(timeout 3s ros2 topic echo --once \
      /r1/live_writer/status std_msgs/msg/String --field data \
      --no-daemon 2>/dev/null || true)"
    [[ -n ${status} ]] && printf 'writer status: %s\n' "${status}"
    if grep -Eq "${prepare_confirmation_pattern}" \
      <<<"${status}"; then
      return 0
    fi
    if grep -Eq \
      'fail_closed reason=prepare_|prepare_cancelled|prepare_in_progress=false.*prepared=false.*kill_clear=false' \
      <<<"${status}"; then
      return 1
    fi
    sleep 0.2
  done
  echo '[BLOCKED] timed out waiting for stable FSM 4/811 locomotion prepare confirmation' >&2
  return 1
}

wait_for_head_auto_center() {
  local deadline=$((SECONDS + 45)) status
  echo 'Waiting for verified normal head tracking or bounded automatic centering...'
  while ((SECONDS < deadline)); do
    status="$(timeout 3s ros2 topic echo --once \
      /r1/live_writer/status std_msgs/msg/String --field data \
      --no-daemon 2>/dev/null || true)"
    [[ -n ${status} ]] && printf 'writer status: %s\n' "${status}"
    if grep -Eq \
      'head_auto_center=complete|head_auto_center_complete=true|head_tracking_seed_verified=true' \
      <<<"${status}"; then
      return 0
    fi
    if grep -Eq 'fail_closed reason=(head_auto_center|head_recenter)' \
      <<<"${status}"; then
      return 1
    fi
    sleep 0.2
  done
  echo '[BLOCKED] timed out waiting for automatic head centering confirmation' >&2
  return 1
}

if grep -Fqi 'boolean value is: true' <<<"${static_prepare_mode}" \
  || grep -Fqi 'boolean value is: true' <<<"${exhibition_session_mode}"; then
  prepare_confirmation_pattern='prepare_result=.*[[:space:]]prepare_rearm=ready|prepared=true.*prepare_rearm=ready'
else
  prepare_confirmation_pattern='prepare_result=.*[[:space:]]prepare_rearm=await_deadman_release|prepared=true.*prepare_rearm=await_deadman_release'
fi

emergency_relock() {
  set +e
  # Never wait behind an unresponsive writer before latching the independent
  # supervisor. Writer cleanup remains best-effort after the central stop edge.
  timeout 4s ros2 service call /r1/safety/emergency_stop std_srvs/srv/Trigger '{}' >/dev/null 2>&1
  timeout 5s ros2 service call /r1/live_writer/kill std_srvs/srv/Trigger '{}' >/dev/null 2>&1
  set -e
}
trap emergency_relock ERR
trap 'emergency_relock; exit 130' INT TERM

echo 'Releasing the software kill for this acknowledged commissioning step...'
if [[ ${STATIC_READINESS_ATTESTED} == true ]]; then
  prepare_confirm_timeout_sec=${R1_EXHIBITION_PREPARE_CONFIRM_TIMEOUT_SEC:-60}
  [[ ${prepare_confirm_timeout_sec} =~ ^[1-9][0-9]*$ ]] \
    || die 'R1_EXHIBITION_PREPARE_CONFIRM_TIMEOUT_SEC must be a positive integer'
  ((10#${prepare_confirm_timeout_sec} <= 120)) \
    || die 'R1_EXHIBITION_PREPARE_CONFIRM_TIMEOUT_SEC must be at most 120'
  # The helper repeats every acknowledgement locally, preserves the 0.3 s
  # KILL propagation interval and waits for the same structured FSM status.
  # It only removes repeated ROS process/DDS startup from the static path.
  R1_PREPARE_CLIENT_AUTH=post-traffic-gate \
    python3 "${SCRIPT_DIR}/r1-robot-prepare-client" \
      --expected-rearm ready \
      --timeout-sec "$((10#${prepare_confirm_timeout_sec}))"
else
  release="$(timeout 8s ros2 service call /r1/safety/set_kill \
    std_srvs/srv/SetBool '{data: false}' 2>&1)" || {
    printf '%s\n' "${release}" >&2
    false
  }
  printf '%s\n' "${release}"
  grep -Eq 'success[[:space:]]*=[[:space:]]*True|success:[[:space:]]*true' <<<"${release}"

  sleep 0.3
  call_trigger /r1/live_writer/reset_kill
  call_trigger /r1/live_writer/prepare
  wait_for_prepare_confirmation
  if [[ ${head_auto_center_required} == true ]]; then
    wait_for_head_auto_center
  fi
fi
trap - ERR INT TERM

if grep -Fqi 'boolean value is: true' <<<"${static_prepare_mode}"; then
  echo '[OK] static StandUp is confirmed by stable FSM 4.'
  echo 'VR bridge, head, arms, locomotion, FSM 811, and velocity commands are disabled.'
elif grep -Fqi 'boolean value is: true' <<<"${prepare_enter_locomotion}"; then
  echo '[OK] official R1 StandUp is confirmed by stable FSM 4 and Start by stable locomotion FSM 811.'
else
  echo '[OK] official R1 StandUp is confirmed by stable FSM 4.'
  echo 'Locomotion is disabled: Start/FSM 811 and velocity commands were not requested.'
fi
if grep -Fqi 'boolean value is: false' <<<"${static_prepare_mode}" \
  && grep -Fqi 'boolean value is: false' <<<"${exhibition_session_mode}"; then
  echo 'Now release Deadman.'
  echo 'If locomotion is enabled, keep the stick neutral until the writer observes a fresh zero command.'
  echo 'Then press Deadman again; head/arms-only mode skips the neutral-velocity gate.'
  echo 'Only fresh commands received after that new press can be sent.'
fi
echo 'Run make robot-stop or use the physical E-stop at any unexpected behavior.'
