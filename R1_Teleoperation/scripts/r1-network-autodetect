#!/usr/bin/env bash

# Shared read-only network helpers for the R1 operator scripts.
# The helpers do not start SDK clients or send robot commands; they only choose
# the first reachable address from the already configured robot LAN.

r1_valid_ipv4() {
  local address="$1"
  local octets=()
  local octet
  IFS='.' read -r -a octets <<< "${address}"
  [[ "${#octets[@]}" -eq 4 ]] || return 1
  for octet in "${octets[@]}"; do
    [[ "${octet}" =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#${octet} <= 255)) || return 1
  done
}

r1_ping_ip_on_interface() {
  local interface="$1"
  local address="$2"
  command -v ping >/dev/null 2>&1 || return 1
  ping -I "${interface}" -c 1 -W 1 "${address}" >/dev/null 2>&1
}

r1_resolve_control_ip() {
  local interface="$1"
  local primary_ip="$2"
  local pc2_ip="${3:-192.168.123.164}"
  local fallback_list
  local seen=" "
  local candidate

  # PC2 is useful as a separate cable/host diagnostic, but it does not expose
  # the R1 control or camera services. Never silently substitute it for the
  # configured control computer.
  fallback_list="${R1_CONTROL_IP_CANDIDATES:-${primary_ip}}"
  fallback_list="${fallback_list//,/ }"

  for candidate in ${fallback_list}; do
    [[ -n "${candidate}" ]] || continue
    r1_valid_ipv4 "${candidate}" || continue
    case "${seen}" in
      *" ${candidate} "*) continue ;;
    esac
    seen="${seen}${candidate} "
    if r1_ping_ip_on_interface "${interface}" "${candidate}"; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done

  printf '%s\n' "${primary_ip}"
  return 1
}
