#!/usr/bin/env bash
set -euo pipefail

# Join the laptop-local ROS graph and request only the bridge's explicit
# exhibition latch.  One rclpy participant performs the service call and
# observes both acknowledgement topics.  This helper never imports Unitree
# SDK. Emergency clear is available only as an explicit recovery action.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
WORKSPACE_SETUP="${PROJECT_DIR}/ros2_ws/install/setup.bash"
[[ -f "${WORKSPACE_SETUP}" ]] \
  || WORKSPACE_SETUP="${PROJECT_DIR}/install/setup.bash"

die() {
  echo "[BLOCKED] $*" >&2
  echo 'No KILL latch was cleared and no Unitree command was sent.' >&2
  exit 2
}

[[ $# -eq 1 ]] \
  || die 'usage: r1-exhibition-session-gate arm|disarm|pause|resume|resume_ready|health|clear_emergency|safe_stop'
case "$1" in
  arm|disarm|pause|resume|resume_ready|health|clear_emergency|safe_stop) ;;
  *) die 'unknown session action' ;;
esac

[[ -f /opt/ros/humble/setup.bash ]] || die 'ROS 2 Humble is unavailable'
[[ -f "${WORKSPACE_SETUP}" ]] || die "workspace is not built: ${WORKSPACE_SETUP}"
DOMAIN_ID=${R1_LIVE_ROS_DOMAIN_ID:-88}
[[ "${DOMAIN_ID}" =~ ^[0-9]+$ ]] && ((10#${DOMAIN_ID} <= 232)) \
  || die 'R1_LIVE_ROS_DOMAIN_ID must be 0..232'

set +u
source /opt/ros/humble/setup.bash
source "${WORKSPACE_SETUP}"
# shellcheck source=r1-physical-ros-env
source "${SCRIPT_DIR}/r1-physical-ros-env"
set -u
export ROS_DOMAIN_ID="$((10#${DOMAIN_ID}))"
export ROS_LOCALHOST_ONLY=1

TIMEOUT_SEC=8
if [[ "$1" == safe_stop ]]; then
  # The normal path shares one discovery participant and finishes much
  # sooner.  These are only bounded failure budgets: disarm 8 s, central
  # emergency_stop 4 s and writer stop 8 s, plus participant cleanup.
  TIMEOUT_SEC=24
fi
exec "${SCRIPT_DIR}/r1-exhibition-ros-client" "$1" \
  --timeout-sec "${TIMEOUT_SEC}"
