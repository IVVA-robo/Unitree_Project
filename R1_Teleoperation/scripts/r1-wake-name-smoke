#!/usr/bin/env python3
"""Run the wake-name gate against mock ASR phrases.

Examples:
  ./scripts/r1-wake-name-smoke "Добрыня, сколько будет 5+5?"
  printf 'Как дела?\nДобрыня, кто ты?\n' | ./scripts/r1-wake-name-smoke
"""

import argparse
import json
from pathlib import Path
import sys


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT))

from voice_assistant.wake_name_gate import WakeNameGate  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("text", nargs="*", help="one mock ASR phrase")
    args = parser.parse_args()
    gate = WakeNameGate.from_env()
    lines = [" ".join(args.text)] if args.text else sys.stdin
    for line in lines:
        result = gate.process(line.rstrip("\n"))
        print(json.dumps(result.as_dict(), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
