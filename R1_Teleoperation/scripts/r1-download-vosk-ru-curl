#!/usr/bin/env python3
"""Resumable Vosk download using short-lived IPv4 curl range requests."""
from __future__ import annotations

import concurrent.futures
import os
import subprocess
import tempfile
import time
import uuid

URL = "https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip"
TOTAL = 46_236_750
CHUNK = 16 * 1024
WORKERS = int(os.environ.get("R1_VOSK_WORKERS", "2"))
ATTEMPTS = int(os.environ.get("R1_VOSK_ATTEMPTS", "6"))
TIMEOUT = int(os.environ.get("R1_VOSK_TIMEOUT", "20"))
DEST = os.path.abspath(os.environ.get(
    "R1_VOSK_DEST", ".cache/voice-models/vosk-model-small-ru-0.22.full.zip"))
PARTIAL = DEST + ".partial"

os.makedirs(os.path.dirname(DEST), exist_ok=True)
if not os.path.exists(PARTIAL) or os.path.getsize(PARTIAL) != TOTAL:
    with open(PARTIAL, "wb") as f:
        f.truncate(TOTAL)


def present(fd: int, start: int, end: int) -> bool:
    try:
        return (os.lseek(fd, start, os.SEEK_DATA) <= start and
                os.lseek(fd, start, os.SEEK_HOLE) >= end)
    except (AttributeError, OSError):
        return False


with open(PARTIAL, "rb", buffering=0) as existing:
    missing = []
    for start in range(0, TOTAL, CHUNK):
        end = min(TOTAL, start + CHUNK)
        if not present(existing.fileno(), start, end):
            missing.append((start, end))

print(f"resuming {len(missing)}/{(TOTAL + CHUNK - 1) // CHUNK} ranges", flush=True)


def fetch(item: tuple[int, int]) -> tuple[int, bytes]:
    start, end = item
    expected = end - start
    for attempt in range(ATTEMPTS):
        nonce = uuid.uuid4().hex
        with tempfile.NamedTemporaryFile(prefix="vosk-range-", dir=os.path.dirname(PARTIAL),
                                         delete=False) as tmp:
            tmp_path = tmp.name
        try:
            cmd = [
                "curl", "-4", "--fail", "--silent", "--show-error",
                "--connect-timeout", "10", "--max-time", str(TIMEOUT),
                "-A", "Mozilla/5.0", "-e", "https://alphacephei.com/vosk/models",
                "-H", f"Range: bytes={start}-{end - 1}",
                "-H", "Accept-Encoding: identity", "-o", tmp_path,
                f"{URL}?r1_chunk={start}&r1_nonce={nonce}",
            ]
            result = subprocess.run(cmd, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, check=False)
            if result.returncode == 0:
                body = open(tmp_path, "rb").read()
                if len(body) == expected:
                    return start, body
        finally:
            try:
                os.unlink(tmp_path)
            except FileNotFoundError:
                pass
        time.sleep(min(5, 0.5 * (attempt + 1)))
    raise RuntimeError(f"range {start} failed after {ATTEMPTS} attempts")


completed = 0
with concurrent.futures.ThreadPoolExecutor(max_workers=WORKERS) as pool:
    with open(PARTIAL, "r+b", buffering=0) as output:
        for start, body in pool.map(fetch, missing):
            output.seek(start)
            output.write(body)
            completed += 1
            if completed % 50 == 0 or completed == len(missing):
                print(f"downloaded {completed}/{len(missing)} missing ranges", flush=True)

os.replace(PARTIAL, DEST)
print(f"[OK] downloaded {TOTAL} bytes to {DEST}")
