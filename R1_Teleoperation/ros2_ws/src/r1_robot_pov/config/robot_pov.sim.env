# Local Gazebo camera profile for the unified teleoperation application.
# This source subscribes only to ROS Image topics on the local simulation DDS
# domain; it never opens a Unitree transport.
ROBOT_POV_MODE=simulation
ROBOT_POV_VIDEO_ONLY=true
ROBOT_POV_BIND_HOST=0.0.0.0
ROBOT_POV_PORT=8080
ROBOT_POV_ADVERTISE_HOST=auto
ROBOT_POV_MDNS_NAME=robot-pov.local

ROBOT_POV_SOURCE=ros
ROBOT_POV_LAYOUT=stereo
ROBOT_POV_LEFT_TOPIC=/r1/camera/left/left_eye/image_raw
ROBOT_POV_RIGHT_TOPIC=/r1/camera/right/right_eye/image_raw
ROBOT_POV_TRANSPORT=auto
ROBOT_POV_PROFILE=low-latency
ROBOT_POV_ADAPTIVE=true
ROBOT_POV_SWAP_EYES=false
ROBOT_POV_CROP=0,0,0,0
ROBOT_POV_ROTATION=0
ROBOT_POV_FLIP_HORIZONTAL=false
ROBOT_POV_FLIP_VERTICAL=false
ROBOT_POV_STALE_AFTER_SEC=0.75
ROBOT_POV_STEREO_MAX_SKEW_SEC=0.06
ROBOT_POV_RECONNECT_DELAY_SEC=0.5
ROBOT_POV_FOV_DEG=80
ROBOT_POV_IPD_MM=64
ROBOT_POV_DISTORTION_K1=0.0
ROBOT_POV_LOG_DIR=logs/robot_pov
