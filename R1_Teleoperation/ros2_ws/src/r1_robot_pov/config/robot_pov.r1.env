# Physical Unitree R1 front camera through the SDK videohub service.
# This profile is strictly video-only and never imports a motion client.
ROBOT_POV_MODE=exhibition
ROBOT_POV_VIDEO_ONLY=true
ROBOT_POV_BIND_HOST=0.0.0.0
ROBOT_POV_PORT=8080
ROBOT_POV_ADVERTISE_HOST=auto
ROBOT_POV_MDNS_NAME=robot-pov.local
# Offline viewer normally answers headset discovery. The exhibition live
# orchestrator overrides this to false because vr_bridge owns UDP 9091.
ROBOT_POV_DISCOVERY_ENABLED=true

ROBOT_POV_SOURCE=unitree
ROBOT_POV_LAYOUT=mono
ROBOT_POV_UNITREE_INTERFACE=auto
ROBOT_POV_UNITREE_TIMEOUT_SEC=3.0
# The tested R1 videohub returns about 14.4 frames/s.
ROBOT_POV_UNITREE_FPS=15.0

ROBOT_POV_TRANSPORT=auto
ROBOT_POV_PROFILE=low-latency
ROBOT_POV_ADAPTIVE=true
ROBOT_POV_SWAP_EYES=false
ROBOT_POV_CROP=0,0,0,0
ROBOT_POV_ROTATION=0
ROBOT_POV_FLIP_HORIZONTAL=false
ROBOT_POV_FLIP_VERTICAL=false
# The R1 videohub occasionally spends multiple 3 s RPC timeouts while its DDS
# client rematches. Keep the most recent real frame during that bounded
# recovery so the operator preview does not alternate with NO SIGNAL.
ROBOT_POV_STALE_AFTER_SEC=10.0
ROBOT_POV_STEREO_MAX_SKEW_SEC=0.06
ROBOT_POV_RECONNECT_DELAY_SEC=0.5
ROBOT_POV_FOV_DEG=120
ROBOT_POV_IPD_MM=64
ROBOT_POV_DISTORTION_K1=0.0

# Address for the optional preflight ping. The SDK camera client discovers its
# DDS peer on ROBOT_POV_UNITREE_INTERFACE; this value does not identify or pin
# the host serving video, and a failed ping alone does not diagnose that host.
ROBOT_POV_ROBOT_IP=192.168.123.161
ROBOT_POV_LOG_DIR=logs/robot_pov
ROBOT_POV_PREFLIGHT_DURATION_SEC=5

ROBOT_POV_TLS_CERT=
ROBOT_POV_TLS_KEY=
