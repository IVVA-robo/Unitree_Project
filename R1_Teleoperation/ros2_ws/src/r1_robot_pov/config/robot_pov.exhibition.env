# Copy this file for each exhibition and keep it with the laptop/mini-PC.
ROBOT_POV_MODE=exhibition
ROBOT_POV_VIDEO_ONLY=true
ROBOT_POV_BIND_HOST=0.0.0.0
ROBOT_POV_PORT=8080
ROBOT_POV_ADVERTISE_HOST=auto
ROBOT_POV_MDNS_NAME=robot-pov.local

# mock | ros | usb | rtsp
ROBOT_POV_SOURCE=ros
ROBOT_POV_LAYOUT=stereo
ROBOT_POV_LEFT_TOPIC=/r1/camera/left/left_eye/image_raw
ROBOT_POV_RIGHT_TOPIC=/r1/camera/right/right_eye/image_raw

# For USB, use stable /dev/v4l/by-id paths where possible.
# ROBOT_POV_LEFT_SOURCE=/dev/v4l/by-id/REPLACE_LEFT
# ROBOT_POV_RIGHT_SOURCE=/dev/v4l/by-id/REPLACE_RIGHT
# For RTSP, use LAN addresses. Credentials are redacted from diagnostics logs.
# ROBOT_POV_LEFT_SOURCE=rtsp://user:password@192.168.50.20/left
# ROBOT_POV_RIGHT_SOURCE=rtsp://user:password@192.168.50.20/right

ROBOT_POV_TRANSPORT=auto
ROBOT_POV_PROFILE=low-latency
ROBOT_POV_ADAPTIVE=true
ROBOT_POV_SWAP_EYES=false
# top,right,bottom,left crop in source pixels
ROBOT_POV_CROP=0,0,0,0
ROBOT_POV_ROTATION=0
ROBOT_POV_FLIP_HORIZONTAL=false
ROBOT_POV_FLIP_VERTICAL=false
ROBOT_POV_STALE_AFTER_SEC=0.75
ROBOT_POV_STEREO_MAX_SKEW_SEC=0.06
ROBOT_POV_RECONNECT_DELAY_SEC=0.5
ROBOT_POV_FOV_DEG=80
ROBOT_POV_IPD_MM=64
ROBOT_POV_DISTORTION_K1=0.0

# Set only when robot reachability belongs in preflight. Video still cannot move it.
ROBOT_POV_ROBOT_IP=
ROBOT_POV_LOG_DIR=logs/robot_pov
ROBOT_POV_PREFLIGHT_DURATION_SEC=5

# Optional HTTPS for immersive WebXR. Both files must be configured together.
ROBOT_POV_TLS_CERT=
ROBOT_POV_TLS_KEY=
